#!/usr/bin/env node
const { spawn } = require('child_process');
const fs = require('fs');
const path = require('path');

const PID_FILE = path.join(__dirname, 'data', 'server.pid');
const LOG_FILE = path.join(__dirname, 'data', 'server.log');

const args = process.argv.slice(2);
const command = args[0];

if (!fs.existsSync(path.join(__dirname, 'data'))) {
  fs.mkdirSync(path.join(__dirname, 'data'), { recursive: true });
}

function start() {
  if (fs.existsSync(PID_FILE)) {
    console.log('Server is already running (or server.pid exists).');
    return;
  }

  console.log('Starting claude2termux server...');
  const out = fs.openSync(LOG_FILE, 'a');
  const err = fs.openSync(LOG_FILE, 'a');

  const child = spawn('node', ['server.js'], {
    detached: true,
    stdio: ['ignore', out, err]
  });

  fs.writeFileSync(PID_FILE, child.pid.toString());
  child.unref();
  console.log(`Server started in background (PID: ${child.pid}). Logs: ${LOG_FILE}`);
}

function stop() {
  if (!fs.existsSync(PID_FILE)) {
    console.log('Server is not running.');
    return;
  }

  const pid = parseInt(fs.readFileSync(PID_FILE, 'utf8'));
  try {
    process.kill(pid, 'SIGTERM');
    console.log(`Stopped server (PID: ${pid}).`);
  } catch (e) {
    console.log(`Could not stop process ${pid}: ${e.message}`);
  }
  fs.unlinkSync(PID_FILE);
}

function status() {
  if (fs.existsSync(PID_FILE)) {
    const pid = fs.readFileSync(PID_FILE, 'utf8');
    console.log(`Server is running (PID: ${pid}).`);
  } else {
    console.log('Server is not running.');
  }
}

function logs() {
  if (fs.existsSync(LOG_FILE)) {
    const content = fs.readFileSync(LOG_FILE, 'utf8');
    console.log(content.split('\n').slice(-50).join('\n'));
  } else {
    console.log('No log file found.');
  }
}

switch (command) {
  case 'start':
  case 'start-daemon':
    start();
    break;
  case 'stop':
    stop();
    break;
  case 'status':
    status();
    break;
  case 'logs':
    logs();
    break;
  default:
    console.log('Usage: claude2t [start|stop|status|logs]');
}
